{
  "name": "vscode-pylearner",
  "displayName": "Python Learner",
  "description": "AI-powered Python learning companion",
  "version": "0.1.1",
  "publisher": "deeptutor",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Machine Learning"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pylearner-sidebar",
          "title": "Python Learner",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "pylearner-sidebar": [
        {
          "type": "webview",
          "id": "pylearner.chatView",
          "name": "Chat"
        }
      ],
      "debug": [
        {
          "type": "tree",
          "id": "pylearner.assignmentPanel",
          "name": "课堂作业"
        }
      ]
    },
    "commands": [
      {
        "command": "pylearner.setStudentIdentity",
        "title": "Python Learner: 设置学号/姓名"
      },
      {
        "command": "pylearner.submitExercise",
        "title": "提交作业（当前文件）",
        "category": "Python Learner",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "pylearner.pullAssignments",
        "title": "拉取作业",
        "category": "Python Learner",
        "icon": "$(repo-pull)"
      },
      {
        "command": "pylearner.restoreSubmissions",
        "title": "恢复我的提交",
        "category": "Python Learner",
        "icon": "$(history)"
      },
      {
        "command": "pylearner.openChat",
        "title": "Python Learner: Open Chat"
      },
      {
        "command": "pylearner.newChat",
        "title": "Python Learner: New Chat"
      },
      {
        "command": "pylearner.toggleMonitor",
        "title": "Python Learner: Toggle Monitoring"
      },
      {
        "command": "pylearner.openSettings",
        "title": "Python Learner: Settings"
      },
      {
        "command": "pylearner.updateProfile",
        "title": "Python Learner: Update Learner Profile"
      },
      {
        "command": "pylearner.resetProfile",
        "title": "Python Learner: Reset Learner Profile"
      },
      {
        "command": "pylearner.memoryGraph",
        "title": "Python Learner: Memory Graph"
      },
      {
        "command": "pylearner.openDataFolder",
        "title": "Python Learner: 打开数据文件夹"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pylearner.submitExercise",
          "when": "editorLangId == python",
          "group": "navigation@901"
        },
        {
          "command": "pylearner.pullAssignments",
          "when": "editorLangId == python",
          "group": "navigation@902"
        },
        {
          "command": "pylearner.restoreSubmissions",
          "when": "editorLangId == python",
          "group": "navigation@903"
        }
      ]
    },
    "configuration": {
      "title": "Python Learner",
      "properties": {
        "pylearner.llm.provider": {
          "type": "string",
          "default": "teacher",
          "enum": [
            "teacher",
            "vscode-lm",
            "ollama",
            "openai"
          ],
          "description": "LLM provider for chat（teacher = 经课堂服务器代理，学生无需配置模型）"
        },
        "pylearner.llm.model": {
          "type": "string",
          "default": "",
          "description": "Model name (optional, provider-specific)"
        },
        "pylearner.llm.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for Ollama/OpenAI-compatible API"
        },
        "pylearner.monitor.editEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Monitor Python file edits"
        },
        "pylearner.monitor.runEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Monitor Python script execution"
        },
        "pylearner.memory.autoRefreshThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Min new learning events before the profile auto-refreshes in the background"
        },
        "pylearner.memory.autoRefreshCooldownMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Min interval (ms) between automatic background profile refreshes"
        },
        "pylearner.teacher.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "教师端服务器地址，学生 L1 trace 将上报到此地址"
        },
        "pylearner.teacher.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否开启教师端上报（将学生 L1 trace 事件发送到教师服务器）"
        },
        "pylearner.submission.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用作业提交通道"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "build:webview": "cd webview-ui && npm run build",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ulidx": "^1.0.0"
  }
}
